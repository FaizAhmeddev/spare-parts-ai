# Copy to .env (docker compose) or set in your shell / Task Scheduler.
SPAREAI_SOURCE=excel                 # excel | csv | sql
SPAREAI_DB_URL=                      # e.g. mssql+pyodbc://user:pw@host/ERP?driver=ODBC+Driver+18+for+SQL+Server
SPAREAI_AS_OF=                       # analysis date YYYY-MM-DD, blank = latest data
SPAREAI_API_KEY=                     # required header X-API-Key for POST /api/runs when set
SPAREAI_LOG_LEVEL=INFO
SPAREAI_WAREHOUSE=data/warehouse/spareai.db
